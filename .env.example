# Dutchie API Configuration
# The base URL for Dutchie POS API endpoints
DUTCHIE_API_URL=https://api.pos.dutchie.com
# Your Dutchie API key for authentication (uses API key as username with Basic Auth)
DUTCHIE_API_KEY=your_dutchie_api_key_here
# Optional: Single retailer ID (only needed if not using all_stores.json)
DUTCHIE_RETAILER_ID=

# Elasticsearch Configuration
# Production Elasticsearch instance on Railway
ELASTICSEARCH_NODE=https://elasticsearch-production-486b.up.railway.app
# Optional: Only needed if Elasticsearch has security/authentication enabled
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=

# Elasticsearch Indices (one index per data type)
ELASTICSEARCH_INDEX_PRODUCTS=dutchie_products
ELASTICSEARCH_INDEX_MENU=dutchie_menu
ELASTICSEARCH_INDEX_ORDERS=dutchie_orders
ELASTICSEARCH_INDEX_TRANSACTIONS=dutchie_transactions

# Backward compatibility
ELASTICSEARCH_INDEX=dutchie_products

# Application Configuration
LOG_LEVEL=info
BATCH_SIZE=100

# Store Configuration
# Path to the store configuration file (default: all_stores.json in project root)
# STORE_CONFIG_PATH=./all_stores.json
